{
  "version": "1.0-healthcare",
  "name": "Horizon-HealthCare（中国医药/医保/集采情报雷达）",
  "description": "专为 LeoLiao vault 定制 · 聚焦国家医保局 / 药监局 / CDE / 集采 / 医药政策 + 国际医药动态",
  "ai": {
    "provider": "minimax",
    "model": "MiniMax-M3",
    "base_url": "https://api.minimax.io/v1",
    "api_key_env": "MINIMAX_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh",
      "en"
    ],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5,
    "system_prompt_suffix": "你是中国医药行业的资深政策分析师 + 商业情报专家。优先关注：医保目录调整、集采降价、药品审批、临床指南更新、商业战略变化、价格谈判、医保支付方式改革。涉及中国特有政策时（如医保谈判、首发价格形成机制、集采梯度降价等），请提供背景解释和影响评估。对企业战略、医药公司估值影响、跨行业影响（如对原料药/CMO/CDMO 的影响）做深度分析。"
  },
